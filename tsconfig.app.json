{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["index.ts", "**/*.ts", "**/*.test.js", "**/*.test.ts"],
  "exclude": ["node_modules", "slimProducts.js", "secretConstants.js"]
}
